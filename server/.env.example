HOST=127.0.0.1
PORT=8787
DATABASE_PATH=./data/capsule-sms.sqlite
PUBLIC_BASE_URL=https://sms.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_TTL_HOURS=12
MESSAGE_TTL_HOURS=168
# Set to 1 only for local HTTP development. Remote credentials require HTTPS.
ALLOW_INSECURE_HTTP=0
# Set to 1 when the app is behind Caddy or another trusted reverse proxy.
TRUST_PROXY=1
